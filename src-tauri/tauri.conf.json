{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keues Monitors",
  "version": "../package.json",
  "identifier": "com.keues.monitors",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:11225",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keues Monitors",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/tts": "tts"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwN0RDNTA3QzYzNkQ4MTkKUldRWjJEYkdCOFY5NEZEb1ZsSnBDQjl6RVhLN2NaeUNpY2VxMDVVZklCVkwzazBnWVVUQXFhWkYK",
      "endpoints": [
        "https://github.com/HastaCs/Keues-Monitors/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
